<?xml version="1.0" ?>
<!-- Swarm arena for the R2C/hybrid Gazebo demo.
     1000x1000 m ground plane matching the paper's area, plus a red box
     marking the jammer's home position (field center). -->
<sdf version="1.9">
  <world name="swarm_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material><ambient>0.3 0.36 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- jammer position marker (field center, matches rf.py default) -->
    <model name="jammer_marker">
      <static>true</static>
      <pose>500 500 1 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>4 4 2</size></box></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
